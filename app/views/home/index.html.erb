<div class="home-page-wrapper">
  <!-- Floating magical elements -->
  <div class="home-magic-elements">
    <div class="magic-star star-1">✨</div>
    <div class="magic-star star-2">⭐</div>
    <div class="magic-star star-3">🌟</div>
    <div class="magic-book book-1">📖</div>
    <div class="magic-book book-2">📚</div>
  </div>

  <!-- Main content container -->
  <div class="home-hero-container">
    <!-- Welcome card with glassmorphism -->
    <div class="home-welcome-card">
      <!-- Animated logo -->
      <div class="home-logo-wrapper">
        <div class="home-logo-icon">📖</div>
        <div class="home-logo-sparkles">
          <span class="sparkle s1">✨</span>
          <span class="sparkle s2">✨</span>
          <span class="sparkle s3">✨</span>
        </div>
      </div>

      <!-- Welcome text -->
      <h1 class="home-welcome-title">Welcome to <span class="brand-name">Talez</span></h1>
      <p class="home-welcome-subtitle">Where every child becomes the hero of their own story</p>

      <!-- Feature cards -->
      <div class="home-features">
        <div class="home-feature-card">
          <div class="feature-icon">✨</div>
          <h3 class="feature-title">Choose Your Hero</h3>
          <p class="feature-desc">Pick your favorite character to star in amazing adventures</p>
        </div>

        <div class="home-feature-card">
          <div class="feature-icon">🌍</div>
          <h3 class="feature-title">Explore Worlds</h3>
          <p class="feature-desc">Discover magical universes from enchanted forests to distant galaxies</p>
        </div>

        <div class="home-feature-card">
          <div class="feature-icon">📝</div>
          <h3 class="feature-title">Create Stories</h3>
          <p class="feature-desc">Let AI craft personalized tales with beautiful illustrations</p>
        </div>
      </div>

      <!-- Mobile Desktop Recommendation -->
      <div class="desktop-recommendation">
         🖥️ Better experience on desktop
      </div>

      <!-- CTA buttons -->
      <div class="home-cta-section">
        <%= link_to new_user_session_path, class: "home-cta-btn primary" do %>
          <i class="fas fa-sign-in-alt"></i>
          <span>Sign In</span>
        <% end %>

        <%= link_to new_user_registration_path, class: "home-cta-btn secondary" do %>
          <i class="fas fa-rocket"></i>
          <span>Start Your Adventure</span>
        <% end %>
      </div>
    </div>

    <!-- Bottom tagline -->
    <p class="home-tagline">
      <span class="tagline-emoji">🌙</span>
      Magical stories await...
      <span class="tagline-emoji">🌙</span>
    </p>
  </div>
</div>
